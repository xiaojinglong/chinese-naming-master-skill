  "naming_xiyongshen_mapping": {
    "description": "喜用神五行 → 推荐十神类型 → 取名用字五行方向",
    "mappings": [
      {
        "xiyongshen_wuxing": "木",
        "favorable_shishen": ["正印", "偏印"],
        "naming_direction": "取名用字五行宜属木（生我者），主学问、贵人、保护",
        "when": "日主身弱且喜木"
      },
      {
        "xiyongshen_wuxing": "木",

    "命中用户明确忌用的字"
  ],
  "soft_filters": [
    {"item": "生僻字（非一级常用字）", "penalty": -40},
    {"item": "单字康熙笔画 > 20", "penalty": -20},
    {"item": "姓名总笔画 > 40", "penalty": -10}
  ]
